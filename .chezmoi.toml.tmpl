{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $isWork := promptBoolOnce . "is_work" "Is this a work machine" false -}}
[data]
email = {{ $email | quote }}
is_work = {{ $isWork }}
{{- /* Hand-added API tokens would be dropped when init regenerates this file. */}}
{{- range $key := list "notion_api_token" "shortcut_api_token" }}
{{- with index $ $key }}
{{ $key }} = {{ . | quote }}
{{- end }}
{{- end }}
