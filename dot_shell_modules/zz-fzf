# ===== FZF INTEGRATION =====
# Named zz-fzf to load last and override other completions

require_command fzf "fzf not installed. $(install_hint fzf)" || return

# Load fzf shell integrations
# - completion.zsh: Enables ** tab completion and context-sensitive fuzzy completion
# - key-bindings.zsh: Ctrl+R (history), Ctrl+T (files), Alt+C (cd to dir)
# Source locations differ per install method; Debian/Ubuntu ship them under
# /usr/share/doc/fzf/examples, and their older fzf has no `fzf --zsh`.
__fzf_shell_dir=""
if has_command brew && [ -d "$(brew --prefix)/opt/fzf/shell" ]; then
  __fzf_shell_dir="$(brew --prefix)/opt/fzf/shell"
else
  for __d in /usr/share/doc/fzf/examples /usr/share/fzf; do
    [ -f "$__d/key-bindings.zsh" ] && { __fzf_shell_dir="$__d"; break; }
  done
  unset __d
fi

if [ -n "$__fzf_shell_dir" ]; then
  [ -f "$__fzf_shell_dir/completion.zsh" ] && source "$__fzf_shell_dir/completion.zsh"
  source "$__fzf_shell_dir/key-bindings.zsh"
elif fzf --zsh &>/dev/null; then
  source <(fzf --zsh)
fi
unset __fzf_shell_dir
