# git-tools-freshness — warn at shell start if the git-tools checkout is stale.
#
# git-tools backs `wm`/`wmc`, start-ticket.sh, and the /start Claude command.
# It is a chezmoi git-repo external (.chezmoiexternal.toml); `chezmoi update`
# pulls it. This module only nags — it does not pull.

_git_tools_freshness() {
  local d="$HOME/Documents/Development/git-tools"
  [[ -d "$d/.git" ]] || return 0
  command -v git >/dev/null || return 0

  # Throttled, non-blocking fetch: at most once every 4h. The stamp is touched
  # on every attempt (success or not) so a flaky connection can't cause a fetch
  # storm; worst case the warning lags reality by ~4h.
  local stamp="$d/.git/.freshness-fetch" now last=0
  now=$(date +%s)
  [[ -f "$stamp" ]] && last=$(stat -f %m "$stamp" 2>/dev/null || stat -c %Y "$stamp" 2>/dev/null || echo 0)
  if (( now - last > 14400 )); then
    { git -C "$d" fetch --quiet 2>/dev/null; touch "$stamp"; } &!
  fi

  # Offline comparison against the last-fetched upstream.
  local behind ahead
  behind=$(git -C "$d" rev-list --count 'HEAD..@{upstream}' 2>/dev/null) || return 0
  ahead=$(git -C "$d" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)

  (( behind > 0 )) && print -P "%F{yellow}⚠  git-tools is ${behind} commit(s) behind%f — run %Bchezmoi update%b  (needed for /start, wm)"
  (( ahead  > 0 )) && print -P "%F{yellow}⚠  git-tools has ${ahead} unpushed commit(s)%f — push so your other machines get them"
  return 0
}
_git_tools_freshness
