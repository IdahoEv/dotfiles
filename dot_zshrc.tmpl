for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x $__brew ]] && { eval "$($__brew shellenv)"; break; }
done
unset __brew

export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
[[ -x /usr/libexec/path_helper ]] && eval "$(/usr/libexec/path_helper)" # might cause issues at work where I haven't installed latex

if (( $+commands[oh-my-posh] )); then
    __posh_theme="$HOME/.config/oh-my-posh/theme.json"
    [[ -f $__posh_theme ]] && eval "$(oh-my-posh init zsh --config $__posh_theme)"
    unset __posh_theme
fi



# load modules
for file in ~/.shell_modules/*
    do
        if [ -f "$file" ]
        # echo "loading $file"
        then source "$file"
        fi
    done
export PATH="$HOME/.local/bin:$PATH"
